{
    "name": "lending-app",
    "private": true,
    "type": "module",
    "workspaces": [
        "shared",
        "apps/*"
    ],
    "scripts": {
        "dev": "concurrently -n server,client \"npm run dev -w @lending/server\" \"npm run dev -w @lending/client\"",
        "test": "npm test --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "concurrently": "^10.0.7",
        "prettier": "^3.9.10",
        "typescript": "^5.6.0",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    }
}
